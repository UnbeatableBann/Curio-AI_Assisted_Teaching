# ==============================================
# CurioSlides AI PPT Generator - Environment Variables
# ==============================================
# Copy this file to .env and fill in your API keys

# ==============================================
# REQUIRED: Google Gemini API Key
# ==============================================
# Get your API key from: https://makersuite.google.com/app/apikey
# This is used for AI-powered slide generation and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# OPTIONAL: Unsplash API Key
# ==============================================
# Get your API key from: https://unsplash.com/developers
# This is used for fetching relevant images for slides
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ==============================================
# OPTIONAL: Flask Configuration
# ==============================================
# Set to 'production' in production environment
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
